{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "U-CUDA (Linux)",
      "type": "gdb",
      "request": "launch",
      "target": "${command:cmake.launchTargetPath}",
      "cwd": "${command:cmake.launchTargetDirectory}",
      "preLaunchTask": "CMake: build",
      "gdbpath": "/usr/bin/gdb",
      "valuesFormatting": "prettyPrinters"
    },
    {
      "name": "U-CUDA (Windows)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "cwd": "${command:cmake.launchTargetDirectory}",
      "preLaunchTask": "CMake: build",
      "console": "integratedTerminal"
    }
  ]
}
