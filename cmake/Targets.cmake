function(ucuda_library name)
    add_library(ucuda_${name} STATIC ${ARGN})
    add_library(ucuda::${name} ALIAS ucuda_${name})
    target_include_directories(ucuda_${name} PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}/include")
    target_compile_features(ucuda_${name} PUBLIC cxx_std_17)
    if(WIN32)
        target_compile_definitions(ucuda_${name} PUBLIC NOMINMAX WIN32_LEAN_AND_MEAN)
    endif()
    if(MSVC)
        target_compile_options(ucuda_${name} PUBLIC $<$<COMPILE_LANGUAGE:CXX>:/utf-8>)
        set_target_properties(ucuda_${name} PROPERTIES COMPILE_PDB_NAME ucuda_${name})
    endif()
endfunction()
