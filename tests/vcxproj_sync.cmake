# The classic Visual Studio project (U-CUDA.sln / U-CUDA/U-CUDA.vcxproj) and CMake describe the same build.
# Every library source listed in libs/*/CMakeLists.txt must be compiled by the .vcxproj and the other way round.
# Run: cmake -DROOT=<repo> -P tests/vcxproj_sync.cmake
cmake_minimum_required(VERSION 3.25)
if(NOT ROOT)
    message(FATAL_ERROR "ROOT is not set")
endif()

set(cmake_sources "")
file(GLOB lib_lists "${ROOT}/libs/*/CMakeLists.txt")
foreach(list_file IN LISTS lib_lists)
    get_filename_component(lib_dir "${list_file}" DIRECTORY)
    file(RELATIVE_PATH lib_rel "${ROOT}" "${lib_dir}")
    file(READ "${list_file}" text)
    string(REGEX MATCHALL "src/[A-Za-z0-9_./-]+\\.(cpp|cu|c)" found "${text}")
    foreach(src IN LISTS found)
        list(APPEND cmake_sources "${lib_rel}/${src}")
    endforeach()
endforeach()

file(READ "${ROOT}/U-CUDA/U-CUDA.vcxproj" proj)
string(REGEX MATCHALL "<(ClCompile|CudaCompile) Include=\"[^\"]+\"" items "${proj}")
set(vcxproj_sources "")
foreach(item IN LISTS items)
    string(REGEX REPLACE "^<[A-Za-z]+ Include=\"\\.\\.\\\\(.*)\"$" "\\1" path "${item}")
    string(REPLACE "\\" "/" path "${path}")
    if(path MATCHES "^libs/")
        list(APPEND vcxproj_sources "${path}")
    endif()
endforeach()

set(missing "")
foreach(src IN LISTS cmake_sources)
    if(NOT src IN_LIST vcxproj_sources)
        string(APPEND missing "\n  in CMake, not in U-CUDA.vcxproj: ${src}")
    endif()
endforeach()
foreach(src IN LISTS vcxproj_sources)
    if(NOT src IN_LIST cmake_sources)
        string(APPEND missing "\n  in U-CUDA.vcxproj, not in CMake: ${src}")
    endif()
endforeach()
if(missing)
    message(FATAL_ERROR "U-CUDA.vcxproj and CMake disagree:${missing}")
endif()
list(LENGTH cmake_sources n)
message(STATUS "U-CUDA.vcxproj matches CMake: ${n} library sources")
