foreach(test IN LISTS UC_REGRESSION_TESTS UC_DAE_TESTS)
    set(labels regression)
    if(test MATCHES "[Cc]pu")
        list(APPEND labels cpu)
    elseif(test MATCHES "[Gg]pu")
        list(APPEND labels gpu)
    endif()
    if(test MATCHES "Smoke|ArtifactPolicy")
        list(APPEND labels smoke)
    endif()
    set_tests_properties("${test}" PROPERTIES LABELS "${labels}" RUN_SERIAL TRUE TIMEOUT 300)
endforeach()
